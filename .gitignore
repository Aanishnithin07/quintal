# Environments
.venv/
venv/
__pycache__/
*.pyc
node_modules/

# Derived artefacts -- always rebuildable from data/bronze, never committed.
# Bronze itself IS committed: it is the product and it cannot be re-fetched.
data/silver/
data/gold/
*.duckdb
*.duckdb.wal
transform/target/
transform/dbt_packages/
transform/logs/
# The dashboard is rendered from gold in CI, so the HTML is derived like
# everything else below bronze and is not committed.
site/index.html

# Local secrets
.env

# Atomic-write temporaries; never committed, never left behind.
data/bronze/**/*.tmp
